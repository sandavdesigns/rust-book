+
+    fn init() { sodiumoxide::init().unwrap(); }
+    fn hex(data: &[u8]) -> String { data.iter().map(|b| format!("{b:02x}")).collect() }
+    fn pair() -> (Cipher, Cipher) {
+        let key = secretbox::gen_key();
+        (Cipher::new(key.clone(), &[2; 32], &[3; 32], true).unwrap(),
+         Cipher::new(key, &[2; 32], &[3; 32], false).unwrap())
+    }
+
+    #[test]
+    fn official_v1_vectors_and_direction_separation() {
+        init();
+        let key = secretbox::Key([0x11; 32]);
+        // Constants from official hbb_common fae47e0/src/tcp.rs tests.
+        assert_eq!(hex(&Cipher::derive(&key, 1, &[0x22; 32], &[0x33; 32]).unwrap().0),
+                   "c189ec6e1935c0751cfc85a0f075405cae507d7925bb19687caf56cbb54e0ecf");
+        assert_eq!(hex(&Cipher::derive(&key, 2, &[0x22; 32], &[0x33; 32]).unwrap().0),
+                   "8a62648e9195cb10ea900c0a24d2a166c1e982347a2dc6833c3e756bf5715d36");
+        let (mut client, mut server) = pair();
+        let a = client.enc(b"same message").unwrap();
+        let b = server.enc(b"same message").unwrap();
+        assert_ne!(a, b);
+        assert_eq!(server.dec(&a).unwrap(), b"same message");
+        assert_eq!(client.dec(&b).unwrap(), b"same message");
+        assert!(server.dec(&a).is_err()); // replay
+    }
+
+    #[test]
+    fn tampering_reflection_short_frames_and_counter_exhaustion_fail() {
+        init();
+        let (mut client, mut server) = pair();
+        let mut bytes = client.enc(b"request").unwrap();
+        bytes[0] ^= 1;
+        assert!(server.dec(&bytes).is_err());
+        let (mut client, _) = pair();
+        let bytes = client.enc(b"reflection").unwrap();
+        assert!(client.dec(&bytes).is_err());
+        let (_, mut server) = pair();
+        assert!(server.dec(&[]).is_err());
+        assert!(server.dec(&[0]).is_err());
+        server.sent = u64::MAX;
+        assert!(server.enc(b"exhausted").is_err());
+    }
+
+    fn token_messages(token: &str) -> [RendezvousMessage; 3] {
+        let mut punch = RendezvousMessage::new();
+        punch.set_punch_hole_request(hbb_common::rendezvous_proto::PunchHoleRequest {
+            token: token.into(), ..Default::default()
+        });
+        let mut relay = RendezvousMessage::new();
+        relay.set_request_relay(hbb_common::rendezvous_proto::RequestRelay {
+            token: token.into(), ..Default::default()
+        });
+        let mut hc = RendezvousMessage::new();
+        hc.set_hc(hbb_common::rendezvous_proto::HealthCheck {
+            token: token.into(), ..Default::default()
+        });
+        [punch, relay, hc]
+    }
+
+    #[test]
+    fn plaintext_token_and_oversize_are_rejected() {
+        for token in ["", "synthetic-test-token"] {
+            for message in token_messages(token) {
+                let bytes = message.write_to_bytes().unwrap();
+                let mut wire = BytesMut::new();
+                BytesCodec::new().encode(Bytes::from(bytes.clone()), &mut wire).unwrap();
+                let result = SecureCodec::new().decode(&mut wire);
+                if token.is_empty() {
+                    assert_eq!(&result.unwrap().unwrap()[..], bytes.as_slice());
+                } else {
+                    assert_eq!(result.unwrap_err().kind(), io::ErrorKind::PermissionDenied);
+                }
+            }
+        }
+        let mut wire = BytesMut::new();
+        BytesCodec::new().encode(Bytes::from(vec![0; MAX_FRAME + 1]), &mut wire).unwrap();
+        assert!(SecureCodec::new().decode(&mut wire).is_err());
+    }
+
+    async fn connected() -> (TcpStream, TcpStream) {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let client = TcpStream::connect(listener.local_addr().unwrap()).await.unwrap();
+        let (server, _) = listener.accept().await.unwrap();
+        (client, server)
+    }
+
+    #[tokio::test]
+    async fn handshake_rejects_all_three_plaintext_token_types() {
+        init();
+        for message in token_messages("synthetic-test-token") {
+            let (client, server) = connected().await;
+            let (_, sk) = sign::gen_keypair();
+            let task = tokio::spawn(async move {
+                handshake(&mut Framed::new(server, SecureCodec::new()), &sk).await.is_err()
+            });
+            let mut client = Framed::new(client, BytesCodec::new());
+            client.next().await.unwrap().unwrap();
+            client.send(Bytes::from(message.write_to_bytes().unwrap())).await.unwrap();
+            assert!(task.await.unwrap());
+        }
+    }
+
+    fn client_exchange(offer: &[u8], server_pk: &sign::PublicKey, version: u32) -> (RendezvousMessage, Cipher) {
+        let message = RendezvousMessage::parse_from_bytes(offer).unwrap();
+        let Some(Union::KeyExchange(ex)) = message.union else { panic!("missing offer") };
+        assert_eq!(ex.version, 1);
+        let responder = sign::verify(&ex.keys[0], server_pk).unwrap();
+        assert_ne!(responder[31] & 0x80, 0);
+        let signed = sign::verify(&ex.signed_params, server_pk).unwrap();
+        let params = KxParams::parse_from_bytes(signed.strip_prefix(PARAMS_DOMAIN).unwrap()).unwrap();
+        assert_eq!(params.pk.as_ref(), responder.as_slice());
+        assert_eq!(params.version, ex.version);
+        let (pk, sk) = box_::gen_keypair();
+        let key = secretbox::gen_key();
+        let sealed = box_::seal(&key.0, &box_::Nonce([0; 24]), &box_::PublicKey::from_slice(&responder).unwrap(), &sk);
+        let cipher = Cipher::new(key, &pk.0, &responder, true).unwrap();
+        let mut reply = RendezvousMessage::new();
+        reply.set_key_exchange(KeyExchange { keys: vec![Bytes::copy_from_slice(&pk.0), Bytes::from(sealed)], version, ..Default::default() });
+        (reply, cipher)
+    }
+
+    #[tokio::test]
+    async fn coalesced_handshake_and_request_then_moved_sink_response() {
+        init();
+        let (client, server) = connected().await;
+        let (pk, sk) = sign::gen_keypair();
+        let task = tokio::spawn(async move {
+            let mut server = Framed::new(server, SecureCodec::new());
+            assert!(handshake(&mut server, &sk).await.unwrap().is_none());
+            let (mut sink, mut reader) = server.split();
+            assert_eq!(&reader.next().await.unwrap().unwrap()[..], b"first request");
+            // A sink moved to an independent task retains the original codec/counters.
+            let writer = tokio::spawn(async move {
+                sink.send(Bytes::from_static(b"first response")).await.unwrap();
+                sink.send(Bytes::from_static(b"second response")).await.unwrap();
+            });
+            assert_eq!(&reader.next().await.unwrap().unwrap()[..], b"second request");
+            writer.await.unwrap();
+        });
+        let mut client = Framed::new(client, BytesCodec::new());
+        let offer = client.next().await.unwrap().unwrap();
+        let (reply, mut cipher) = client_exchange(&offer, &pk, 1);
+        let mut coalesced = BytesMut::new();
+        let mut codec = BytesCodec::new();
+        codec.encode(Bytes::from(reply.write_to_bytes().unwrap()), &mut coalesced).unwrap();
+        codec.encode(Bytes::from(cipher.enc(b"first request").unwrap()), &mut coalesced).unwrap();
+        codec.encode(Bytes::from(cipher.enc(b"second request").unwrap()), &mut coalesced).unwrap();
+        client.get_mut().write_all(&coalesced).await.unwrap();
+        for expected in [b"first response".as_slice(), b"second response".as_slice()] {
+            assert_eq!(cipher.dec(&client.next().await.unwrap().unwrap()).unwrap(), expected);
+        }
+        task.await.unwrap();
+    }

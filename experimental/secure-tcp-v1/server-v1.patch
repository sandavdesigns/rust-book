+// SPDX-License-Identifier: AGPL-3.0-only
+// v1 key derivation follows rustdesk/hbb_common at
+// fae47e024dd83cef6aaecde0aa7d11731df11649, src/tcp.rs.
+use hbb_common::{
+    anyhow::{anyhow, bail},
+    bytes::{Bytes, BytesMut}, bytes_codec::BytesCodec,
+    futures_util::{SinkExt, StreamExt}, protobuf::Message,
+    rendezvous_proto::{rendezvous_message::Union, KeyExchange, KxParams, RendezvousMessage},
+    tcp::Encrypt, timeout, tokio::net::TcpStream,
+    tokio_util::codec::{Decoder, Encoder, Framed}, ResultType,
+};
+use sodiumoxide::crypto::{box_, generichash, secretbox, sign};
+use std::io;
+
+const VERSION: u32 = 1;
+const PARAMS_DOMAIN: &[u8] = b"rdkx-params";
+const MAX_FRAME: usize = 1024 * 1024;
+
+// Not Clone: counters must belong to the single Framed object shared by split().
+struct Cipher {
+    send: secretbox::Key,
+    recv: secretbox::Key,
+    sent: u64,
+    received: u64,
+}
+
+impl Cipher {
+    fn new(key: secretbox::Key, initiator: &[u8], responder: &[u8], client: bool) -> ResultType<Self> {
+        let a = Self::derive(&key, 1, initiator, responder)?;
+        let b = Self::derive(&key, 2, initiator, responder)?;
+        let (send, recv) = if client { (a, b) } else { (b, a) };
+        Ok(Self { send, recv, sent: 0, received: 0 })
+    }
+
+    fn derive(key: &secretbox::Key, direction: u8, initiator: &[u8], responder: &[u8]) -> ResultType<secretbox::Key> {
+        if initiator.len() != 32 || responder.len() != 32 { bail!("invalid transcript key length"); }
+        let failed = |_| anyhow!("key derivation failed");
+        let mut h = generichash::State::new(Some(32), Some(&key.0)).map_err(failed)?;
+        for part in [b"rdkx-spl".as_slice(), &[direction], &VERSION.to_le_bytes(),
+                     &VERSION.to_le_bytes(), initiator, responder] {
+            h.update(part).map_err(failed)?;
+        }
+        secretbox::Key::from_slice(h.finalize().map_err(failed)?.as_ref())
+            .ok_or_else(|| anyhow!("invalid derived key length"))
+    }
+
+    fn nonce(counter: &mut u64) -> io::Result<secretbox::Nonce> {
+        *counter = counter.checked_add(1).ok_or_else(|| io::Error::new(io::ErrorKind::InvalidData, "nonce exhausted"))?;
+        let mut nonce = secretbox::Nonce([0; secretbox::NONCEBYTES]);
+        nonce.0[..8].copy_from_slice(&counter.to_le_bytes());
+        Ok(nonce)
+    }
+
+    fn enc(&mut self, data: &[u8]) -> io::Result<Vec<u8>> {
+        Ok(secretbox::seal(data, &Self::nonce(&mut self.sent)?, &self.send))
+    }
+
+    fn dec(&mut self, data: &[u8]) -> io::Result<Vec<u8>> {
+        // No unauthenticated one-byte bypass on the rendezvous channel.
+        secretbox::open(data, &Self::nonce(&mut self.received)?, &self.recv)
+            .map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "authentication failed"))
+    }
+}
+
+pub(crate) struct SecureCodec { inner: BytesCodec, cipher: Option<Cipher> }
+
+impl SecureCodec {
+    pub(crate) fn new() -> Self {
+        let mut inner = BytesCodec::new();
+        inner.set_max_packet_length(MAX_FRAME);
+        Self { inner, cipher: None }
+    }
+}
+
+impl Decoder for SecureCodec {
+    type Item = BytesMut;
+    type Error = io::Error;
+    fn decode(&mut self, src: &mut BytesMut) -> io::Result<Option<BytesMut>> {
+        let Some(data) = self.inner.decode(src)? else { return Ok(None) };
+        Ok(Some(match self.cipher.as_mut() {
+            Some(cipher) => BytesMut::from(cipher.dec(&data)?.as_slice()),
+            None => {
+                if let Ok(message) = RendezvousMessage::parse_from_bytes(&data) {
+                    let has_token = match message.union {
+                        Some(Union::PunchHoleRequest(ph)) => !ph.token.is_empty(),
+                        Some(Union::RequestRelay(relay)) => !relay.token.is_empty(),
+                        Some(Union::Hc(hc)) => !hc.token.is_empty(),
+                        _ => false,
+                    };
+                    if has_token {
+                        return Err(io::Error::new(io::ErrorKind::PermissionDenied, "token requires secure TCP"));
+                    }
+                }
+                data
+            },
+        }))
+    }
+}
+
+impl Encoder<Bytes> for SecureCodec {
+    type Error = io::Error;
+    fn encode(&mut self, data: Bytes, dst: &mut BytesMut) -> io::Result<()> {
+        let data = match self.cipher.as_mut() {
+            Some(cipher) => Bytes::from(cipher.enc(&data)?),
+            None => data,
+        };
+        self.inner.encode(data, dst)
+    }
+}
+
+// Called before split, so buffered frames and every subsequent stored sink use
+// one codec. Any malformed exchange terminates the connection; never downgrade.
+pub(crate) async fn handshake(stream: &mut Framed<TcpStream, SecureCodec>, sk: &sign::SecretKey) -> ResultType<Option<BytesMut>> {
+    let (mut pk, ephemeral_sk) = box_::gen_keypair();
+    // X25519 ignores this bit; its signed presence requires signed parameters.
+    pk.0[31] |= 0x80;
+    let params = KxParams { pk: Bytes::copy_from_slice(&pk.0), version: VERSION, ..Default::default() };
+    let mut signed = PARAMS_DOMAIN.to_vec();
+    signed.extend(params.write_to_bytes()?);
+    let mut offer = RendezvousMessage::new();
+    offer.set_key_exchange(KeyExchange {
+        keys: vec![Bytes::from(sign::sign(&pk.0, sk))], version: VERSION,
+        signed_params: Bytes::from(sign::sign(&signed, sk)), ..Default::default()
+    });
+    timeout(5_000, stream.send(Bytes::from(offer.write_to_bytes()?))).await??;
+    let bytes = timeout(5_000, stream.next()).await?.ok_or_else(|| anyhow!("handshake closed"))??;
+    let message = RendezvousMessage::parse_from_bytes(&bytes)?;
+    match message.union {
+        Some(Union::KeyExchange(ex)) => {
+            if ex.version != VERSION || ex.keys.len() != 2 || ex.keys[0].len() != 32 || ex.keys[1].len() != 48 {
+                bail!("secure TCP requires a valid v1 exchange (modern client required)");
+            }
+            let key = Encrypt::decode(&ex.keys[1], &ex.keys[0], &ephemeral_sk)?;
+            stream.codec_mut().cipher = Some(Cipher::new(key, &ex.keys[0], &pk.0, false)?);
+            Ok(None)
+        }
+        Some(Union::PunchHoleRequest(ref ph)) if !ph.token.is_empty() => bail!("token requires secure TCP"),
+        Some(Union::RequestRelay(ref relay)) if !relay.token.is_empty() => bail!("token requires secure TCP"),
+        Some(Union::Hc(ref hc)) if !hc.token.is_empty() => bail!("token requires secure TCP"),
+        _ => Ok(Some(bytes)),
+    }
+}

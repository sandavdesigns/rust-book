FROM rust:1.90-bookworm@sha256:3914072ca0c3b8aad871db9169a651ccfce30cf58303e5d6f2db16d1d8a7e58f
RUN apt-get update && apt-get install -y --no-install-recommends cmake pkg-config clang libclang-dev libsodium-dev libssl-dev && rm -rf /var/lib/apt/lists/*
ENV SODIUM_USE_PKG_CONFIG=1 CARGO_BUILD_JOBS=1
WORKDIR /source
COPY upstream/source/ /source/
RUN cargo test --locked --lib secure_tcp::tests -- --nocapture
RUN cargo build --locked --bin hbbs
CMD ["cargo", "test", "--locked", "--lib"]

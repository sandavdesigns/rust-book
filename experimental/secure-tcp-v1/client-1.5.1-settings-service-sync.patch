+
+pub fn set_server_options(delta: HashMap<String, String>) -> hbb_common::ResultType<()> {
+    const KEYS: [&str; 4] = [
+        "custom-rendezvous-server",
+        "relay-server",
+        "api-server",
+        "key",
+    ];
+    if delta.len() != KEYS.len() || !KEYS.iter().all(|key| delta.contains_key(*key)) {
+        hbb_common::bail!("Expected exactly the four server configuration options");
+    }
+    #[cfg(not(any(target_os = "android", target_os = "ios")))]
+    {
+        match ipc::set_server_options(delta.clone())? {
+            ipc::ServerOptionsUpdate::Updated => {
+                Config::set_server_options(delta.clone())?;
+            }
+            ipc::ServerOptionsUpdate::Unavailable if !crate::platform::is_installed() => {
+                let _chk = ipc::CheckIfRestart::new();
+                let _nat = crate::CheckTestNatType::new();
+                Config::set_server_options(delta.clone())?;
+            }
+            ipc::ServerOptionsUpdate::Unavailable => {
+                hbb_common::bail!("The installed host is unavailable; server settings were not changed");
+            }
+        }
+        let mut options = OPTIONS.lock().unwrap();
+        for (key, value) in delta {
+            if value.is_empty() {
+                options.remove(&key);
+            } else {
+                options.insert(key, value);
+            }
+        }
+    }
+    #[cfg(any(target_os = "android", target_os = "ios"))]
+    Config::set_server_options(delta)?;
     Ok(())
 }
 

+#[tokio::main(flavor = "current_thread")]
+pub async fn set_server_options(
+    delta: HashMap<String, String>,
+) -> ResultType<ServerOptionsUpdate> {
+    if !is_server_options_delta(&delta) {
+        bail!("Expected exactly the four server configuration options");
+    }
+    let ms_timeout = 1_000;
+    let mut c = match connect(ms_timeout, "").await {
+        Ok(connection) => connection,
+        Err(_) => return Ok(ServerOptionsUpdate::Unavailable),
+    };
+    let request = serde_json::to_string(&delta)?;
+    c.send(&Data::Config((SERVER_CONFIG_NAME.to_owned(), Some(request))))
+        .await?;
+    match c.next_timeout(ms_timeout).await? {
+        Some(Data::Config((name, Some(response)))) if name == SERVER_CONFIG_NAME => {
+            let response = match serde_json::from_str::<HashMap<String, String>>(&response) {
+                Ok(response) => response,
+                Err(_) => bail!("Invalid server configuration confirmation"),
+            };
+            if is_server_options_delta(&response)
+                && delta.iter().all(|(key, value)| {
+                    value.is_empty() || response.get(key).is_some_and(|actual| actual == value)
+                })
+            {
+                Ok(ServerOptionsUpdate::Updated)
+            } else {
+                bail!("Server configuration confirmation did not match the request");
+            }
+        }
+        Some(Data::SecurityConfigError(error)) => bail!(error),
+        _ => bail!("The host did not confirm the server configuration update"),
+    }
+}
